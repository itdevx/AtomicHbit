<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> | Atomic Habit</title>
  <link rel="stylesheet" href="/css/app.css">
  <style>@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');</style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
<nav class="nav">
  <div class="wrap">
    <div class="nav-inner">
      <a href="/" class="brand">⚛️ <span>Atomic Habit</span></a>
      <div class="nav-desktop">
        <% if (user) { %>
          <a href="/">خانه</a>
          <a href="/dashboard">داشبورد</a>
          <a href="/focus">تمرکز</a>
          <a href="/pair">دونفره</a>
          <a href="/habits">عادت‌ها</a>
          <a href="/leaderboard">لیدربورد</a>
          <a href="/groups">گروه</a>
          <a href="/history">تاریخچه</a>
        <% } else { %>
          <a href="/science">اصول</a>
          <a href="/auth/login">ورود</a>
          <a href="/auth/register">شروع</a>
        <% } %>
      </div>
      <div class="nav-right">
        <span class="clock" id="iranClock">--:--:--</span>
        <% if (user) { %>
          <a href="/notifications" class="icon-btn" title="اعلان">🔔<span class="dot" id="notifDot"></span></a>
          <a href="/profile" class="icon-btn" title="پروفایل">👤</a>
        <% } %>
        <button type="button" class="menu-btn" id="menuBtn" aria-label="منو">☰</button>
      </div>
    </div>
    <div class="nav-drawer" id="navDrawer">
      <% if (user) { %>
        <a href="/">🏠 خانه</a>
        <a href="/dashboard">📊 داشبورد</a>
        <a href="/focus">⏱️ تایمر تمرکز</a>
        <a href="/pair">🤝 تمرکز دونفره</a>
        <a href="/habits">✅ عادت‌ها</a>
        <a href="/leaderboard">🏆 لیدربورد</a>
        <a href="/groups">👥 گروه‌ها</a>
        <a href="/history">📜 تاریخچه</a>
        <a href="/notifications">🔔 اعلان‌ها</a>
        <a href="/profile">👤 پروفایل</a>
        <a href="/science">🧠 اصول</a>
        <a href="/auth/logout">🚪 خروج</a>
      <% } else { %>
        <a href="/">🏠 خانه</a>
        <a href="/science">🧠 اصول</a>
        <a href="/auth/login">🔑 ورود</a>
        <a href="/auth/register">✨ ثبت‌نام</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="wrap main">
